generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Role {
  OWNER
  RECEPTIONIST
  VETERINARIAN
  GROOMER
  ADMIN
}

enum DocumentType {
  CC
  TI
  RC
  CE
  PA
  NIT
  PPT
}

enum Species {
  DOG
  CAT
  OTHER
}

enum Sex {
  MALE
  FEMALE
}

enum AppointmentType {
  GENERAL_CONSULTATION
  VACCINATION
  CHECKUP
  GROOMING
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum InvoiceStatus {
  PAID
  VOIDED
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique @db.VarChar(254) // RFC 5321: 256 - "<>"
  passwordHash        String     @db.VarChar(60) // salida fija de bcrypt
  status              UserStatus @default(PENDING)
  role                Role       @default(OWNER)
  failedLoginAttempts Int        @default(0) @db.SmallInt // RN-08: bloqueo a los 5
  lockedUntil         DateTime?  @db.Timestamptz(3)
  ownerId             String?    @unique @db.Uuid // RN-04: vínculo 1-1 con el propietario
  veterinarianId      String?    @unique @db.Uuid // 06 §4: perfil profesional del veterinario
  groomerId           String?    @unique @db.Uuid // 06 §4: perfil profesional del estilista
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)

  owner               Owner?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  veterinarian        Veterinarian?        @relation(fields: [veterinarianId], references: [id], onDelete: SetNull)
  groomer             Groomer?             @relation(fields: [groomerId], references: [id], onDelete: SetNull)
  otpCodes            OtpCode[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

model Owner {
  id             String       @id @default(uuid()) @db.Uuid
  documentType   DocumentType @default(CC)
  documentNumber String       @unique @db.VarChar(15) // texto: conserva ceros; el DTO valida 6-10 dígitos (RN-01)
  firstNames     String       @db.VarChar(60)
  lastNames      String       @db.VarChar(60)
  email          String?      @db.VarChar(254)
  phone          String       @db.VarChar(15) // E.164 sin "+"; el DTO recibe 10 dígitos (RN-01)
  address        String?      @db.VarChar(100)
  dataConsentAt  DateTime?    @db.Timestamptz(3) // RN-60: aceptación del tratamiento de datos
  active         Boolean      @default(true) // RN-14: eliminación lógica
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  user     User?
  patients Patient[]
  invoices Invoice[]
}

model Patient {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid // RN-16: todo paciente pertenece a un propietario
  name      String   @db.VarChar(60) // un nombre de mascota; mismo tope que los nombres de persona
  species   Species
  breed     String   @db.VarChar(60) // D-19: texto libre
  sex       Sex
  birthDate DateTime @db.Date // RN-15: la edad se calcula, no se guarda
  weightKg  Decimal  @db.Decimal(5, 2) // D-19: hasta 999,99 kg
  photoPath String?  @db.VarChar(100) // ruta del objeto en Storage: "patients/<uuid>/<uuid>.<ext>"
  active    Boolean  @default(true) // RN-14: eliminación lógica
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  owner         Owner          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  appointments  Appointment[]
  consultations Consultation[]
  vaccinations  Vaccination[]

  @@index([ownerId]) // listado de mascotas por propietario (RF-06, RF-08)
}

model Veterinarian {
  id             String       @id @default(uuid()) @db.Uuid
  documentType   DocumentType @default(CC)
  documentNumber String       @unique @db.VarChar(15)
  firstNames     String       @db.VarChar(60)
  lastNames      String       @db.VarChar(60)
  phone          String       @db.VarChar(15) // E.164 sin "+"
  specialty      String       @db.VarChar(60) // RN-19: texto libre, p. ej. "Medicina interna"
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  user          User?
  schedules     Schedule[]
  appointments  Appointment[]
  consultations Consultation[]
  vaccinations  Vaccination[]
}

model Groomer {
  id             String       @id @default(uuid()) @db.Uuid
  documentType   DocumentType @default(CC)
  documentNumber String       @unique @db.VarChar(15)
  firstNames     String       @db.VarChar(60)
  lastNames      String       @db.VarChar(60)
  phone          String       @db.VarChar(15) // E.164 sin "+"
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  user          User?
  schedules     Schedule[]
  appointments  Appointment[]
  consultations Consultation[]
  vaccinations  Vaccination[]
}

// Bloque de atención semanal (RN-19). Exactamente uno de veterinarianId o groomerId (CHECK en la migración).
model Schedule {
  id             String   @id @default(uuid()) @db.Uuid
  veterinarianId String?  @db.Uuid
  groomerId      String?  @db.Uuid
  weekday        Int      @db.SmallInt // ISO: 1 = lunes … 7 = domingo
  startTime      DateTime @db.Time(0) // hora local de la clínica, sin zona
  endTime        DateTime @db.Time(0)

  veterinarian Veterinarian? @relation(fields: [veterinarianId], references: [id], onDelete: Cascade)
  groomer      Groomer?      @relation(fields: [groomerId], references: [id], onDelete: Cascade)

  @@index([veterinarianId, weekday])
  @@index([groomerId, weekday])
}

// RN-19: duración configurable de cada tipo de cita; múltiplo de la franja de 30 min (D-21).
model AppointmentTypeSetting {
  type            AppointmentType @id
  durationMinutes Int             @db.SmallInt
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
}

// Reserva de una franja (RN-20 a RN-34). Exactamente uno de veterinarianId o groomerId (CHECK en la
// migración, según el tipo, D-21). Las exclusiones GiST de la migración impiden el cruce de franjas
// activas del mismo profesional o de la misma mascota (RN-23, RN-27, RN-32).
model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  patientId      String            @db.Uuid
  type           AppointmentType
  veterinarianId String?           @db.Uuid
  groomerId      String?           @db.Uuid
  startsAt       DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3)
  status         AppointmentStatus @default(SCHEDULED) // RN-25
  reason         String?           @db.VarChar(200) // motivo libre del propietario o de recepción
  cancelReason   String?           @db.VarChar(200) // RN-30: obligatorio al cancelar
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  veterinarian Veterinarian? @relation(fields: [veterinarianId], references: [id], onDelete: Restrict)
  groomer      Groomer?      @relation(fields: [groomerId], references: [id], onDelete: Restrict)
  consultation Consultation?

  @@index([patientId, startsAt]) // "mis citas" y límite de citas activas por mascota (RN-24)
  @@index([veterinarianId, startsAt]) // agenda por veterinario (RF-16)
  @@index([groomerId, startsAt]) // agenda por estilista
  @@index([startsAt]) // agenda diaria de recepción
}

// RN-43 a RN-46: una consulta por cita CONFIRMED; la fórmula es texto libre porque el inventario está en Reserva (D-27).
model Consultation {
  id             String   @id @default(uuid()) @db.Uuid
  appointmentId  String   @unique @db.Uuid
  patientId      String   @db.Uuid
  veterinarianId String   @db.Uuid
  symptoms       String   @db.VarChar(500)
  weightKg       Decimal  @db.Decimal(5, 2)
  temperatureC   Decimal  @db.Decimal(3, 1) // 0,0 a 99,9 °C
  diagnosis      String   @db.VarChar(500) // RN-45
  treatment      String   @db.VarChar(500) // RN-45
  prescription   String?  @db.VarChar(1000) // fórmula en texto libre
  internalNotes  String?  @db.VarChar(1000) // RN-42: nunca se muestra al propietario
  cost           Decimal  @db.Decimal(12, 2) // COP
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  veterinarian Veterinarian @relation(fields: [veterinarianId], references: [id], onDelete: Restrict)
  invoiceItem  InvoiceItem?
  groomer      Groomer?     @relation(fields: [groomerId], references: [id])
  groomerId    String?      @db.Uuid

  @@index([patientId, createdAt]) // historial (RN-41)
}

// Catálogo mínimo de vacunas con precio de venta (D-27); sin stock hasta HU-18.
model Vaccine {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique @db.VarChar(60)
  price        Decimal       @db.Decimal(12, 2)
  active       Boolean       @default(true)
  vaccinations Vaccination[]
}

model Vaccination {
  id             String    @id @default(uuid()) @db.Uuid
  patientId      String    @db.Uuid
  veterinarianId String    @db.Uuid
  vaccineId      String    @db.Uuid
  lot            String    @db.VarChar(30)
  appliedAt      DateTime  @db.Date // RN-48
  nextDoseAt     DateTime? @db.Date
  price          Decimal   @db.Decimal(12, 2) // precio del catálogo al aplicar
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  veterinarian Veterinarian @relation(fields: [veterinarianId], references: [id], onDelete: Restrict)
  vaccine      Vaccine      @relation(fields: [vaccineId], references: [id], onDelete: Restrict)
  invoiceItem  InvoiceItem?
  groomer      Groomer?     @relation(fields: [groomerId], references: [id])
  groomerId    String?      @db.Uuid

  @@index([patientId, appliedAt])
}

// RN-70 a RN-76. El número es consecutivo y se muestra como FAC-000001 (D-27).
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  number        Int           @unique @default(autoincrement())
  ownerId       String        @db.Uuid
  status        InvoiceStatus @default(PAID)
  paymentMethod PaymentMethod
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  voidReason    String?       @db.VarChar(200) // RN-74
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  owner Owner         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  items InvoiceItem[]

  @@index([ownerId, createdAt])
}

// RN-73: cada detalle referencia su concepto de origen (una consulta o una vacunación).
model InvoiceItem {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @db.Uuid
  consultationId String? @unique @db.Uuid
  vaccinationId  String? @unique @db.Uuid
  description    String  @db.VarChar(120)
  amount         Decimal @db.Decimal(12, 2)
  taxed          Boolean @default(true) // RN-71, D-27

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  vaccination  Vaccination?  @relation(fields: [vaccinationId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model OtpCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @db.VarChar(60) // OTP hasheado con bcrypt
  attempts  Int       @default(0) @db.SmallInt // máx. 5
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid // jti
  userId    String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64) // SHA-256 en hex del token opaco (RN-11)
  expiresAt DateTime  @db.Timestamptz(3) // 30 minutos
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
