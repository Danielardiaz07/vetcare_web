generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Role {
  OWNER
  RECEPTIONIST
  VETERINARIAN
  GROOMER
  ADMIN
}

enum DocumentType {
  CC
  TI
  RC
  CE
  PA
  NIT
  PPT
}

enum Species {
  DOG
  CAT
  OTHER
}

enum Sex {
  MALE
  FEMALE
}

enum AppointmentType {
  GENERAL_CONSULTATION
  VACCINATION
  CHECKUP
  GROOMING
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique @db.VarChar(254) // RFC 5321: 256 - "<>"
  passwordHash        String     @db.VarChar(60) // salida fija de bcrypt
  status              UserStatus @default(PENDING)
  role                Role       @default(OWNER)
  failedLoginAttempts Int        @default(0) @db.SmallInt // RN-08: bloqueo a los 5
  lockedUntil         DateTime?  @db.Timestamptz(3)
  ownerId             String?    @unique @db.Uuid // RN-04: vínculo 1-1 con el propietario
  veterinarianId      String?    @unique @db.Uuid // 06 §4: perfil profesional del veterinario
  groomerId           String?    @unique @db.Uuid // 06 §4: perfil profesional del estilista
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)

  owner               Owner?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  veterinarian        Veterinarian?        @relation(fields: [veterinarianId], references: [id], onDelete: SetNull)
  groomer             Groomer?             @relation(fields: [groomerId], references: [id], onDelete: SetNull)
  otpCodes            OtpCode[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

model Owner {
  id             String       @id @default(uuid()) @db.Uuid
  documentType   DocumentType @default(CC)
  documentNumber String       @unique @db.VarChar(15) // texto: conserva ceros; el DTO valida 6-10 dígitos (RN-01)
  firstNames     String       @db.VarChar(60)
  lastNames      String       @db.VarChar(60)
  email          String?      @db.VarChar(254)
  phone          String       @db.VarChar(15) // E.164 sin "+"; el DTO recibe 10 dígitos (RN-01)
  address        String?      @db.VarChar(100)
  dataConsentAt  DateTime?    @db.Timestamptz(3) // RN-60: aceptación del tratamiento de datos
  active         Boolean      @default(true) // RN-14: eliminación lógica
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  user     User?
  patients Patient[]
}

model Patient {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid // RN-16: todo paciente pertenece a un propietario
  name      String   @db.VarChar(60) // un nombre de mascota; mismo tope que los nombres de persona
  species   Species
  breed     String   @db.VarChar(60) // D-19: texto libre
  sex       Sex
  birthDate DateTime @db.Date // RN-15: la edad se calcula, no se guarda
  weightKg  Decimal  @db.Decimal(5, 2) // D-19: hasta 999,99 kg
  photoPath String?  @db.VarChar(100) // ruta del objeto en Storage: "patients/<uuid>/<uuid>.<ext>"
  active    Boolean  @default(true) // RN-14: eliminación lógica
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId]) // listado de mascotas por propietario (RF-06, RF-08)
}

model Veterinarian {
  id             String       @id @default(uuid()) @db.Uuid
  documentType   DocumentType @default(CC)
  documentNumber String       @unique @db.VarChar(15)
  firstNames     String       @db.VarChar(60)
  lastNames      String       @db.VarChar(60)
  phone          String       @db.VarChar(15) // E.164 sin "+"
  specialty      String       @db.VarChar(60) // RN-19: texto libre, p. ej. "Medicina interna"
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  user      User?
  schedules Schedule[]
}

model Groomer {
  id             String       @id @default(uuid()) @db.Uuid
  documentType   DocumentType @default(CC)
  documentNumber String       @unique @db.VarChar(15)
  firstNames     String       @db.VarChar(60)
  lastNames      String       @db.VarChar(60)
  phone          String       @db.VarChar(15) // E.164 sin "+"
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  user      User?
  schedules Schedule[]
}

// Bloque de atención semanal (RN-19). Exactamente uno de veterinarianId o groomerId (CHECK en la migración).
model Schedule {
  id             String   @id @default(uuid()) @db.Uuid
  veterinarianId String?  @db.Uuid
  groomerId      String?  @db.Uuid
  weekday        Int      @db.SmallInt // ISO: 1 = lunes … 7 = domingo
  startTime      DateTime @db.Time(0) // hora local de la clínica, sin zona
  endTime        DateTime @db.Time(0)

  veterinarian Veterinarian? @relation(fields: [veterinarianId], references: [id], onDelete: Cascade)
  groomer      Groomer?      @relation(fields: [groomerId], references: [id], onDelete: Cascade)

  @@index([veterinarianId, weekday])
  @@index([groomerId, weekday])
}

// RN-19: duración configurable de cada tipo de cita; múltiplo de la franja de 30 min (D-21).
model AppointmentTypeSetting {
  type            AppointmentType @id
  durationMinutes Int             @db.SmallInt
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
}

model OtpCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @db.VarChar(60) // OTP hasheado con bcrypt
  attempts  Int       @default(0) @db.SmallInt // máx. 5
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid // jti
  userId    String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64) // SHA-256 en hex del token opaco (RN-11)
  expiresAt DateTime  @db.Timestamptz(3) // 30 minutos
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
