# Local: http://localhost:3001/api/v1. Producción: https://<dominio-del-front>/api/v1 (pasa por los rewrites)
NEXT_PUBLIC_API_URL=
# Solo servidor. Si se define, Next reenvía /api/v1/* a esa API (producción); en local se deja vacío
API_PROXY_TARGET=
# true: services/ responde con datos de prueba en lugar de llamar a la API (D-24)
NEXT_PUBLIC_USE_MOCKS=
# default | new-account | slow | network-error (por defecto: default)
NEXT_PUBLIC_MOCK_SCENARIO=
